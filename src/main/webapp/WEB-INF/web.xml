<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>PoliDinner</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Servlet 4.0: parámetros y respuestas en UTF-8 (tildes y eñes) -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Errores no controlados: mensaje amigable sin stack trace (el detalle queda en el log de Tomcat) -->
    <error-page>
        <error-code>404</error-code>
        <location>/vistas/comun/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/vistas/comun/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/vistas/comun/error.jsp</location>
    </error-page>
</web-app>
